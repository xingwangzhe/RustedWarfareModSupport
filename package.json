{
  "name": "rustedwarfaremodsupport",
  "displayName": "RustedWarfareModSupport",
  "version": "1.7.48",
  "description": "A VS Code extension that provides in-editor completions, documentation hints, and development tools for RustedWarfare mod development. Supports INI file editing with intelligent autocompletion for game configuration properties.",
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "completion",
    "development",
    "game-development",
    "hover",
    "ini",
    "mod",
    "modding",
    "rustedwarfare",
    "vscode-extension"
  ],
  "homepage": "https://github.com/xingwangzhe/RustedWarfareModSupport",
  "bugs": {
    "url": "https://github.com/xingwangzhe/RustedWarfareModSupport/issues"
  },
  "license": "AGPL-3.0",
  "author": "xingwangzhe",
  "repository": {
    "type": "git",
    "url": "https://github.com/xingwangzhe/RustedWarfareModSupport.git"
  },
  "publisher": "xingwangzhe",
  "main": "./dist/extension.js",
  "scripts": {
    "merge-translations": "node merge.js",
    "generate-syntax": "node scripts/generateSyntax.js",
    "assets": "run-p merge-translations generate-syntax",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "bundle": "node esbuild.js",
    "bundle:prod": "node esbuild.js --production",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:esbuild": "node esbuild.js --watch --incremental",
    "watch:parallel": "run-p watch:tsc watch:esbuild",
    "watch": "run-s assets watch:parallel",
    "compile": "run-s assets check-types bundle",
    "dev": "run-s assets bundle",
    "dev:watch": "npm run watch",
    "package": "run-s assets check-types lint bundle:prod",
    "package:vsix": "run-s assets check-types lint bundle:prod vsce:package",
    "publish:vsix": "run-s assets check-types lint bundle:prod vsce:publish",
    "vsce:package": "vsce package",
    "vsce:publish": "vsce publish",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "test": "vscode-test",
    "sort-translations": "node scripts/sort-translations.mjs",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "@vscode/l10n": "^0.0.18",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.1",
    "@types/vscode": "^1.106.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.12",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "typescript": "^5.9.3"
  },
  "l10n": "./translation",
  "contributes": {
    "commands": [
      {
        "command": "rustedwarfaremodsupport.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "rustedwarfaremodsupport.exportDirect",
        "title": "直接导出Mod包"
      },
      {
        "command": "rustedwarfaremodsupport.exportAuto",
        "title": "自动导出Mod包 (ZIP + RWMOD)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rustedwarfaremodsupport-explorer",
          "title": "RustedWarfare Mod",
          "icon": "./resources/mod-icon.svg"
        }
      ]
    },
    "views": {
      "rustedwarfaremodsupport-explorer": [
        {
          "id": "rustedwarfaremodsupport-panel",
          "name": "Mod Panel",
          "icon": "./resources/mod-icon.svg",
          "contextualTitle": "RustedWarfare Mod Panel"
        }
      ]
    },
    "grammars": [
      {
        "language": "ini",
        "scopeName": "source.ini",
        "path": "./syntaxes/ini.tmLanguage.json",
        "fileTypes": [
          "ini",
          "template"
        ],
        "filenames": [
          "mod-info.txt"
        ]
      }
    ],
    "languages": [
      {
        "id": "ini",
        "aliases": [
          "INI"
        ],
        "extensions": [
          ".ini",
          ".template"
        ],
        "filenames": [
          "mod-info.txt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "RustedWarfareModSupport",
      "properties": {
        "rustedwarfaremodsupport.showFoldingControls": {
          "type": "string",
          "default": "always",
          "enum": [
            "always",
            "mouseover"
          ],
          "enumDescriptions": [
            "Always show folding controls",
            "Show folding controls on mouseover"
          ],
          "description": "Controls when folding controls are shown."
        },
        "rustedwarfaremodsupport.customFileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Custom file extensions to support in addition to the default ones (.ini, .template, mod-info.txt)"
        },
        "rustedwarfaremodsupport.enablePerfLogs": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose performance timings for completion, hover, and decoration diagnostics"
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "favicon.png",
  "engines": {
    "vscode": "^1.106.1"
  }
}
