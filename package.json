{
  "name": "rustedwarfaremodsupport",
  "displayName": "RustedWarfareModSupport",
  "icon": "favicon.png",
  "description": "A VS Code extension that provides in-editor completions, documentation hints, and development tools for RustedWarfare mod development. Supports INI file editing with intelligent autocompletion for game configuration properties.",
  "version": "1.7.28",
  "author": "xingwangzhe",
  "publisher": "xingwangzhe",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/xingwangzhe/RustedWarfareModSupport",
  "repository": {
    "type": "git",
    "url": "https://github.com/xingwangzhe/RustedWarfareModSupport.git"
  },
  "bugs": {
    "url": "https://github.com/xingwangzhe/RustedWarfareModSupport/issues"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./translation",
  "contributes": {
    "commands": [
      {
        "command": "rustedwarfaremodsupport.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "rustedwarfaremodsupport.exportDirect",
        "title": "直接导出Mod包"
      },
      {
        "command": "rustedwarfaremodsupport.exportAuto",
        "title": "自动导出Mod包 (ZIP + RWMOD)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rustedwarfaremodsupport-explorer",
          "title": "RustedWarfare Mod",
          "icon": "./resources/mod-icon.svg"
        }
      ]
    },
    "views": {
      "rustedwarfaremodsupport-explorer": [
        {
          "id": "rustedwarfaremodsupport-panel",
          "name": "Mod Panel",
          "icon": "./resources/mod-icon.svg",
          "contextualTitle": "RustedWarfare Mod Panel"
        }
      ]
    },
    "grammars": [
      {
        "language": "ini",
        "scopeName": "source.ini",
        "path": "./syntaxes/ini.tmLanguage.json",
        "fileTypes": [
          "ini",
          "template"
        ],
        "filenames": [
          "mod-info.txt"
        ]
      }
    ],
    "languages": [
      {
        "id": "ini",
        "aliases": [
          "INI"
        ],
        "extensions": [
          ".ini",
          ".template"
        ],
        "filenames": [
          "mod-info.txt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "RustedWarfareModSupport",
      "properties": {
        "rustedwarfaremodsupport.showFoldingControls": {
          "type": "string",
          "default": "always",
          "enum": [
            "always",
            "mouseover"
          ],
          "enumDescriptions": [
            "Always show folding controls",
            "Show folding controls on mouseover"
          ],
          "description": "Controls when folding controls are shown."
        },
        "rustedwarfaremodsupport.customFileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Custom file extensions to support in addition to the default ones (.ini, .template, mod-info.txt)"
        }
      }
    }
  },
  "keywords": [
    "rustedwarfare",
    "mod",
    "development",
    "ini",
    "completion",
    "hover",
    "vscode-extension",
    "game-development",
    "modding"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "precompile": "node merge.js",
    "compile": "tsc -b",
    "prewatch": "node merge.js",
    "watch": "tsc -b -w",
    "prewatch:esbuild": "node merge.js",
    "watch:esbuild": "node esbuild.js --watch",
    "prewatch:tsc": "node merge.js",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "prepackage": "node merge.js",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "precompile-tests": "node merge.js",
    "compile-tests": "tsc -p . --outDir out",
    "prewatch-tests": "node merge.js",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "presort-translations": "node merge.js",
    "check-types": "tsc --noEmit",
    "prelint": "node merge.js",
    "lint": "eslint src translation",
    "test": "vscode-test",
    "sort-translations": "node scripts/sort-translations.mjs",
    "merge-translations": "node merge.js",
    "package:vsix": "npm run merge-translations && vsce package",
    "publish:vsix": "npm run merge-translations && vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "esbuild": "^0.25.9",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  },
  "dependencies": {
    "@vscode/l10n": "^0.0.18",
    "jszip": "^3.10.1"
  }
}
