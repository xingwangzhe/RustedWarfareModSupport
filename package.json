{
  "name": "rustedwarfaremodsupport",
  "displayName": "RustedWarfare Mod Support",
  "version": "1.9.57",
  "description": "RustedWarfare 模组开发工具，提供编辑器内的智能补全、文档提示、代码格式化、颜色/图片预览与 Mod 导出。支持 INI 文件的属性自动补全、逻辑布尔表达式补全、单位生成补全，多语言翻译支持，助力 RustedWarfare mod 开发。A RustedWarfare mod development toolkit with intelligent completions, documentation hints, INI formatting, color/image previews and mod export for VS Code.",
  "categories": [
    "Formatters",
    "Other",
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "completion",
    "development",
    "formatter",
    "game-development",
    "hover",
    "ini",
    "l10n",
    "mod",
    "modding",
    "multi-language",
    "rustedwarfare",
    "vscode-extension"
  ],
  "homepage": "https://github.com/xingwangzhe/RustedWarfareModSupport",
  "bugs": {
    "url": "https://github.com/xingwangzhe/RustedWarfareModSupport/issues"
  },
  "license": "AGPL-3.0",
  "author": "xingwangzhe",
  "repository": {
    "type": "git",
    "url": "https://github.com/xingwangzhe/RustedWarfareModSupport.git"
  },
  "publisher": "xingwangzhe",
  "main": "./dist/extension.js",
  "scripts": {
    "merge-translations": "bun merge.js",
    "generate-syntax": "bun scripts/generateSyntax.js",
    "assets": "bun run --parallel merge-translations generate-syntax",
    "check:types": "tsc --noEmit",
    "check": "bun run check:types",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build": "vite build",
    "build:min": "vite build",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:build": "vite build --watch",
    "watch": "bun run --parallel watch:tsc watch:build",
    "compile": "bun run --sequential assets check:types lint build fmt",
    "dev": "bun run --sequential assets build",
    "dev:watch": "bun run watch",
    "package": "bun run --sequential assets check:types lint build:min fmt",
    "package:vsix": "bun run --sequential vsce:package",
    "publish:vsix": "bun run --sequential vsce:publish",
    "vsce:package": "vsce package",
    "vsce:publish": "vsce publish",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "test": "vitest run",
    "test:watch": "vitest",
    "sort-translations": "bun scripts/sort-translations.mjs",
    "vscode:prepublish": "bun run package"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vsce": "^2.15.0"
  },
  "l10n": "./translation",
  "contributes": {
    "commands": [
      {
        "command": "rustedwarfaremodsupport.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "rustedwarfaremodsupport.formatIni",
        "title": "%formatIni%"
      },
      {
        "command": "rustedwarfaremodsupport.exportDirect",
        "title": "直接导出Mod包"
      },
      {
        "command": "rustedwarfaremodsupport.exportAuto",
        "title": "自动导出Mod包 (ZIP + RWMOD)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rustedwarfaremodsupport-explorer",
          "title": "RustedWarfare Mod",
          "icon": "./resources/mod-icon.svg"
        }
      ]
    },
    "views": {
      "rustedwarfaremodsupport-explorer": [
        {
          "id": "rustedwarfaremodsupport-panel",
          "name": "Mod Panel",
          "icon": "./resources/mod-icon.svg",
          "contextualTitle": "RustedWarfare Mod Panel"
        }
      ]
    },
    "grammars": [
      {
        "language": "ini",
        "scopeName": "source.ini",
        "path": "./syntaxes/ini.tmLanguage.json",
        "fileTypes": [
          "ini",
          "template"
        ],
        "filenames": [
          "mod-info.txt"
        ]
      }
    ],
    "languages": [
      {
        "id": "ini",
        "aliases": [
          "INI"
        ],
        "extensions": [
          ".ini",
          ".template"
        ],
        "filenames": [
          "mod-info.txt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "RustedWarfareModSupport",
      "properties": {
        "rustedwarfaremodsupport.showFoldingControls": {
          "type": "string",
          "default": "always",
          "enum": [
            "always",
            "mouseover"
          ],
          "enumDescriptions": [
            "Always show folding controls",
            "Show folding controls on mouseover"
          ],
          "description": "Controls when folding controls are shown."
        },
        "rustedwarfaremodsupport.customFileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Custom file extensions to support in addition to the default ones (.ini, .template, mod-info.txt)"
        },
        "rustedwarfaremodsupport.enablePerfLogs": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose performance timings for completion, hover, and decoration diagnostics"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "when": "editorLangId == ini",
          "command": "rustedwarfaremodsupport.formatIni",
          "group": "navigation"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "favicon.png",
  "engines": {
    "vscode": "^1.125.0"
  }
}
