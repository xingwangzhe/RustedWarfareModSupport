{
  "name": "INI",
  "scopeName": "source.ini",
  "patterns": [
    {
      "include": "#multistring"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#section"
    },
    {
      "include": "#templateKey"
    },
    {
      "include": "#memoryDefinition"
    },
    {
      "include": "#key"
    },
    {
      "include": "#keyvalue"
    }
  ],
  "repository": {
    "multistring": {
      "begin": "\"\"\"\"\"\"",
      "end": "\"\"\"\"\"\"",
      "name": "text.ini",
      "patterns": [
        {
          "include": "#multistring-content"
        }
      ]
    },
    "multistring-content": {
      "match": "[^\"]+",
      "name": "text.ini",
      "patterns": [
        {
          "include": "#localRef"
        },
        {
          "include": "#filePath"
        },
        {
          "include": "#customVariable"
        }
      ]
    },
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.ini"
    },
    "section": {
      "match": "^\\s*\\[([^\\]]+)\\]",
      "name": "entity.name.section.ini",
      "captures": {
        "1": { "name": "entity.name.section.ini" }
      }
    },
    "templateKey": {
      "name": "storage.type.templateKey.ini",
      "match": "(?<!\\w+: *)(@\\w+)"
    },
    "memoryDefinition": {
      "name": "storage.type.memoryDefinition.ini",
      "match": "(?<!\\w+: *)@memory\\s+\\w+:\\w+"
    },
    "key": {
      "name": "variable.other.key.ini",
      "match": "(?<!\\w+: *)\\w+:"
    },
    "keyvalue": {
      "begin": "^\\s*([A-Za-z0-9_\\.\\-]+)\\s*:",
      "beginCaptures": {
        "1": { "name": "variable.other.key.ini" },
        "0": { "name": "punctuation.separator.keyvalue.ini" }
      },
      "end": "$",
      "name": "meta.key-value.ini",
      "patterns": [
        {
          "include": "#localRef"
        },
        {
          "include": "#filePath"
        },
        {
          "include": "#customVariable"
        },
        {
          "include": "#multistring-content"
        },
        {
          "match": "#.*$",
          "name": "comment.line.number-sign.ini"
        }
      ]
    },
    "localRef": {
      "name": "storage.type.localRef.ini",
      "match": "(\\${[^{}]*}|%(?={))"
    },
    "filePath": {
      "name": "support.class.filePath.ini",
      "match": "(ROOT:)?[^\\s]+\\.(ini|txt|template|png|ogg|wav)"
    },
    "customVariable": {
      "name": "variable.parameter.customVariable.ini",
      "match": "\\b(memory\\.\\w+|resource\\.\\w+|null|index)\\b"
    }
  }
}