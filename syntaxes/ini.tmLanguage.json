{
  "name": "INI",
  "scopeName": "source.ini",
  "patterns": [
    {
      "include": "#multistring"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#section"
    },
    {
      "include": "#keyvalue"
    }
  ],
  "repository": {
    "multistring": {
      "begin": "\"\"\"\"\"\"",
      "end": "\"\"\"\"\"\"",
      "name": "text.ini",
      "patterns": [
        {
          "include": "#multistring-content"
        }
      ]
    },
    "multistring-content": {
      "match": "[^\"]+",
      "name": "text.ini"
    }
    ,
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.ini"
    },
    "section": {
      "match": "^\\s*\\[([^\\]]+)\\]",
      "name": "entity.name.section.ini",
      "captures": {
        "1": { "name": "entity.name.section.ini" }
      }
    },
    "keyvalue": {
      "begin": "^\\s*([A-Za-z0-9_\\.\\-]+)\\s*:",
      "beginCaptures": {
        "1": { "name": "variable.other.key.ini" },
        "0": { "name": "punctuation.separator.keyvalue.ini" }
      },
      "end": "$",
      "name": "meta.key-value.ini",
      "patterns": [
        {
          "include": "#multistring-content"
        },
        {
          "match": "#.*$",
          "name": "comment.line.number-sign.ini"
        }
      ]
    }
  }
}